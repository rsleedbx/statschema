# ── Live database test credentials ────────────────────────────────────────────
# These are read by tests/test_live_*.py via os.environ.get().
# The defaults below match the passwords used in the Podman/Docker commands in
# docs/local-databases.md.  Only change them if you started the containers with
# different passwords.

# MySQL  (Podman containers; default: testpass)
MYSQL_ROOT_PASS=testpass
MYSQL57_PORT=3357
MYSQL8_PORT=3384

# MariaDB  (Podman containers; default: testpass)
MARIADB_HOST=127.0.0.1
MARIADB_ROOT_PASS=testpass
MARIADB_LTS_PORT=3310
MARIADB_NEW_PORT=3311

# IBM Db2 CE  (Lima VM + QEMU; see config/lima/db2.yaml)
DB2_HOST=127.0.0.1
DB2_PORT=50000
DB2_USER=db2inst1
DB2_PASS=testpass
DB2_DATABASE=testdb
# DB2 ADMIN_CMD LOAD requires a shared filesystem — see STATSCHEMA_SERVER_STAGING_DIR below.

# PostgreSQL  (Podman containers; default: testpass)
PG_PASSWORD=testpass
PG_DB=testdb
PG14_PORT=5414
PG16_PORT=5416

# NeonDB / Neon Local (optional — cloud-backed Postgres proxy; NOT the neondatabase/neon binaries image)
# Image: docker.io/neondatabase/neon_local:latest — see docs/local-databases.md
# Prefer NEON_DATABASE_URL from the Neon console (includes SSL params). Otherwise use discrete vars below.
# NEON_DATABASE_URL=postgresql://user:pass@ep-....neon.tech/neondb?sslmode=require
NEON_HOST=127.0.0.1
NEON_LOCAL_PORT=55433
NEON_USER=neon
NEON_PASSWORD=npg
NEON_DATABASE=neondb
# NEON_SSLMODE=require

# SQL Server  (Lima QEMU VM; password is randomly generated on first boot)
# Retrieve it with:
#   limactl shell sqlserver22 -- \
#     sudo grep 'SQL Server sa password' /var/log/cloud-init-output.log \
#     | tail -1 | awk '{print $NF}'
SQLSERVER_PASS=
SQLSERVER_PORT=14330

# Oracle XE  (Lima QEMU VM; password is set via ORACLE_PWD in config/lima/oracle.yaml)
# Default password matches the oracle.yaml provisioning script (ORACLE_PWD=oracle).
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_USER=system
ORACLE_PASS=oracle
ORACLE_SERVICE=XE
ORACLE_SCHEMA=STATSCHEMA_TEST

# Mautic (application-level tests)
# Mautic database lives on the existing mysql8 Podman container.
# See docs/local-databases.md for one-time Mautic setup commands.
MAUTIC_MYSQL_HOST=127.0.0.1
MAUTIC_MYSQL_PORT=3384
MAUTIC_MYSQL_USER=mautic
MAUTIC_MYSQL_PASS=mauticpass
MAUTIC_MYSQL_DB=mautic

# Gitea (PostgreSQL application tests)
# Gitea git service running against pg16. See docs/local-databases.md.
GITEA_PG_HOST=127.0.0.1
GITEA_PG_PORT=5416
GITEA_PG_USER=gitea
GITEA_PG_PASS=gitea123
GITEA_PG_DB=gitea

# PostgreSQL 18 (stats transpiler tests)
# Start with: podman run -d --name pg18 -e POSTGRES_PASSWORD=postgres -p 5418:5432 postgres:18
# Required for test_live_stats_transpiler.py (pg_restore_attribute_stats is PG18+ only).
PG18_HOST=127.0.0.1
PG18_PORT=5418

# Databricks Lakebase  (cloud-managed Postgres; see scripts/lakebase-up.sh)
# Run `./scripts/lakebase-up.sh` to create the endpoint and populate these vars.
# Auth is via ~/.databrickscfg DEFAULT profile (or DATABRICKS_PROFILE env var).
#
# STATSCHEMA_LAKEBASE_ENDPOINT=projects/<proj>/branches/<branch>/endpoints/<ep>
# STATSCHEMA_LAKEBASE_HOST=<ep>.database.<region>.cloud.databricks.com
STATSCHEMA_LAKEBASE_DB=databricks_postgres
# STATSCHEMA_LAKEBASE_USER=<service-principal-client-id>   # UUID; set by lakebase-up.sh

# CockroachDB  (Podman containers — native ARM64 on Apple Silicon)
# See docs/local-databases.md → "CockroachDB" for single-node and multi-region setup.
# Both scenarios use psycopg2 with sslmode=disable (insecure mode).
# Single-node: podman run -d --name crdb-single -p 26257:26257 cockroachdb/cockroach:latest start-single-node --insecure
# Multi-region: 3-node cluster; connect to node-1 on CRDB_MULTI_PORT (see docs).
CRDB_HOST=127.0.0.1
CRDB_USER=root
CRDB_SINGLE_PORT=26257
CRDB_MULTI_PORT=26267

# ── Shared filesystem staging ─────────────────────────────────────────────────
# Required for file-based bulk loaders:
#   • DB2  — ADMIN_CMD LOAD / IMPORT (shared_fs topology)
#   • Oracle — External Tables (ORACLE_LOADER) and SQL*Loader (sqlldr)
#   • SQL Server — BULK INSERT fallback (pyodbc/pymssql; mssql-python BCP does not use staging)
#
# STATSCHEMA_CLIENT_STAGING_DIR  — path where statschema WRITES staging files
#                                  (the mount point on statschema's host)
# STATSCHEMA_SERVER_STAGING_DIR  — path where the DB server READS those files
#                                  (the mount point as seen by the DB server process)
#
# Lima dev setup (both sides see the same path via virtfs bind-mount):
STATSCHEMA_CLIENT_STAGING_DIR=/tmp/lima/statschema
STATSCHEMA_SERVER_STAGING_DIR=/tmp/lima/statschema
#
# NFS example (client and server see different mount points for the same share):
# STATSCHEMA_CLIENT_STAGING_DIR=/mnt/nfs/statschema      # statschema host
# STATSCHEMA_SERVER_STAGING_DIR=/data/shared/statschema  # DB server host

# Oracle DIRECTORY object name pointing to STATSCHEMA_SERVER_STAGING_DIR.
# Create once after Lima Oracle is up:
#   limactl shell oracle -- sqlplus system/oracle@XE <<'SQL'
#   CREATE OR REPLACE DIRECTORY STATSCHEMA_STAGING AS '/tmp/lima/statschema';
#   GRANT READ, WRITE ON DIRECTORY STATSCHEMA_STAGING TO PUBLIC;
#   SQL
ORACLE_SERVER_DIRECTORY=STATSCHEMA_STAGING
# Full path of the sqlldr binary on the statschema host (where statschema runs).
# sqlldr is a client-side tool: reads CSV locally, streams rows to Oracle over TCP.
# On macOS ARM64 + Lima, sqlldr is only available inside the Lima VM — leave unset
# on a macOS dev machine.  Set this only if sqlldr is installed locally:
#   Linux x86_64 (RPM install):  /usr/lib/oracle/21/client64/bin/sqlldr
#   macOS (Instant Client Tools): /opt/oracle/instantclient_21_12/sqlldr
# ORACLE_SQLLDR_BINARY=
